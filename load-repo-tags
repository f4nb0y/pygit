#!/usr/bin/env python3
"""Load tag refs from JSON"""

import json
import sys

from git import Repo


def main(args):
    repo = Repo.init()
    load = json.load(sys.stdin)
    arg0 = args[0].split('/')[-1]
    for tag, ref in load.items():
        repo.create_tag(tag, ref=ref, message=f'Tagged by {arg0}', force=True)


if __name__ == '__main__':
    main(sys.argv)
