#!/usr/bin/env python3
"""Save tag refs to JSON"""

import json
import sys

from git import Repo


def main(args: list[str]):
    repo = Repo.init()
    tags = repo.tags
    save = {}
    for tag in args[1:]:
        try:
            ref = tags[tag].commit.hexsha
        except IndexError:
            sys.exit(f'Tag not found: {tag}')
        save[tag] = ref
    print(json.dumps(save))


if __name__ == '__main__':
    main(sys.argv)
