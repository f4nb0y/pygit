#!/usr/bin/env python3
"""Save tag refs to JSON"""

import json
import os.path
import sys

from git import Repo

arg0 = os.path.basename(sys.argv[0])


def die(msg):
    sys.exit(f'{arg0}: {msg}')


def main(args: list[str]):
    repo = Repo.init()
    save = {}
    for tag in args[1:]:
        try:
            ref = repo.tag(tag).commit.hexsha
        except Exception as e:
            die(e)
        save[tag] = ref
    print(json.dumps(save))


if __name__ == '__main__':
    main(sys.argv)
